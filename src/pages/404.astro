---
import Base from "../layouts/Base.astro";
---

<Base
  title="Not found — SparkyBin Browser"
  description="That page does not exist."
>
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-5 py-20 sm:px-8">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">No such page</h1>
    <p class="mt-5 text-lg text-ink-soft">
      The link is broken, or the page was moved. The useful places are the
      download page and the repository.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/download"
        class="inline-flex items-center gap-2 rounded-lg bg-ink px-5 py-2.5 text-sm font-medium text-bg transition-transform hover:-translate-y-px"
      >
        Download
      </a>
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-lg border border-rule-strong px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
      >
        Back to the front page
      </a>
    </div>
  </section>
</Base>
