---
import light from "../assets/screenshot.png";
import dark from "../assets/screenshot-dark.png";

interface Props {
  alt: string;
  caption?: string;
}

const { alt, caption } = Astro.props;
---

<figure>
  <div
    class="overflow-hidden rounded-xl border border-rule-strong bg-surface shadow-lift"
  >
    {
      /*
        There is a copy of the screenshot for each palette, and the one
        that matches the theme the reader is looking at is the one shown.
        The other is never rendered, so it is never fetched.
      */
    }
    <img
      src={light.src}
      alt={alt}
      width="1268"
      height="808"
      loading="lazy"
      decoding="async"
      class="shot-light block w-full"
    />
    <img
      src={dark.src}
      alt={alt}
      width="1268"
      height="808"
      loading="lazy"
      decoding="async"
      class="shot-dark block w-full"
    />
  </div>
  {
    caption && (
      <figcaption class="mt-4 text-sm text-ink-faint">{caption}</figcaption>
    )
  }
</figure>
