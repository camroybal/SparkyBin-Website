---
import screenshot from "../assets/screenshot.png";

interface Props {
  src?: string;
  alt: string;
  caption?: string;
}

const { src = screenshot.src, alt, caption } = Astro.props;
---

<figure class="group">
  <div
    class="overflow-hidden rounded-xl border border-rule-strong bg-surface shadow-lift transition-transform duration-300 group-hover:-translate-y-0.5"
  >
    <img src={src} alt={alt} width="1268" height="808" class="block w-full" />
  </div>
  {
    caption && (
      <figcaption class="mt-4 text-sm text-ink-faint">{caption}</figcaption>
    )
  }
</figure>
