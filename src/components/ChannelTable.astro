---
import { RELEASES_URL } from "../lib/releases";

interface Props {
  version: string;
  releaseUrl: string;
}

const { version, releaseUrl } = Astro.props;

const channels = [
  {
    name: "Stable",
    tag: version,
    description: "A tagged release, built against the WebKit in the GNOME 51 runtime.",
    href: releaseUrl,
    cta: "Download",
    state: "ready",
  },
  {
    name: "Devel",
    tag: "tip of main",
    description: "The same build, tracking the main branch. For testing changes.",
    href: null,
    cta: "Not published yet",
    state: "soon",
  },
  {
    name: "Canary",
    tag: "tip of main",
    description: "Built against WebKit main. Breaks more often, and sometimes will not start.",
    href: null,
    cta: "Not published yet",
    state: "soon",
  },
];
---

<div class="overflow-hidden rounded-xl border border-rule bg-surface">
  <div
    class="hidden border-b border-rule px-5 py-3 sm:grid sm:grid-cols-[11rem_7rem_1fr_auto] sm:gap-5"
  >
    <span class="font-mono text-xs font-medium tracking-widest text-ink-faint uppercase">
      Channel
    </span>
    <span class="font-mono text-xs font-medium tracking-widest text-ink-faint uppercase">
      Build
    </span>
    <span class="font-mono text-xs font-medium tracking-widest text-ink-faint uppercase">
      Notes
    </span>
    <span></span>
  </div>

  <ul>
    {
      channels.map((channel) => (
        <li class="grid gap-2 border-b border-rule px-5 py-4 last:border-b-0 sm:grid-cols-[11rem_7rem_1fr_auto] sm:items-start sm:gap-5">
          <div>
            <span class="font-display font-semibold">{channel.name}</span>
            <span
              class:list={[
                "ml-2 rounded-full px-2 py-0.5 font-mono text-[0.65rem] tracking-wide uppercase",
                channel.state === "ready"
                  ? "bg-accent-soft text-accent"
                  : "bg-bg-tint text-ink-faint",
              ]}
            >
              {channel.state === "ready" ? "Recommended" : "Soon"}
            </span>
          </div>
          <div class="font-mono text-xs text-ink-faint">{channel.tag}</div>
          <div class="text-sm text-ink-soft">{channel.description}</div>
          <div>
            {channel.href ? (
              <a
                href={channel.href}
                class="inline-flex items-center gap-1 whitespace-nowrap rounded-lg border border-rule-strong px-3 py-1.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
              >
                {channel.cta}
                <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="whitespace-nowrap text-sm text-ink-faint">
                {channel.cta}
              </span>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</div>

<p class="mt-3 text-sm text-ink-faint">
  Every release is on <a class="text-ink-soft underline underline-offset-2 hover:text-accent" href={RELEASES_URL}>GitHub</a>.
</p>
