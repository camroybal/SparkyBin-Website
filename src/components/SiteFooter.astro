---
import { REPO_URL, ISSUES_URL, UPSTREAM_URL } from "../lib/releases";
import { PRODUCTS } from "../lib/products";
import { siteUrl } from "../lib/urls";
---

<footer class="border-t border-rule bg-bg-tint">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <a
          href={siteUrl("/")}
          class="font-display text-sm font-semibold transition-colors hover:text-accent"
          >SparkyBin</a
        >
        <p class="mt-2 max-w-xs text-sm text-ink-soft">
          Software for the desktop, built on free software and released under
          the GPL.
        </p>
      </div>

      <div>
        <p class="font-mono text-xs font-medium tracking-widest text-ink-faint uppercase">
          Projects
        </p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            PRODUCTS.map((product) => (
              <li>
                <a
                  href={siteUrl(product.base)}
                  class="text-ink-soft transition-colors hover:text-accent"
                >
                  {product.name}
                  <span class="text-ink-faint"> — {product.tagline}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-mono text-xs font-medium tracking-widest text-ink-faint uppercase">
          Browser
        </p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-ink-soft transition-colors hover:text-accent" href={siteUrl("/download")}>Download</a></li>
          <li><a class="text-ink-soft transition-colors hover:text-accent" href={siteUrl("/source")}>Build from source</a></li>
          <li>
            <a class="text-ink-soft transition-colors hover:text-accent" href={REPO_URL}>Repository</a>
          </li>
          <li>
            <a class="text-ink-soft transition-colors hover:text-accent" href={ISSUES_URL}>Report a bug</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-rule pt-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        SparkyBin Browser is free software under the GNU GPL v3 or later. It is
        built on <a class="underline underline-offset-2 hover:text-accent" href={UPSTREAM_URL}>GNOME Web</a>.
      </p>
      <p class="font-mono">Not affiliated with the GNOME Foundation.</p>
    </div>
  </div>
</footer>
