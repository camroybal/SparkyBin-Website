---
import { REPO_URL, ISSUES_URL } from "../lib/releases";

const links = [
  { href: "/download", label: "Download" },
  { href: "/source", label: "Source" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-40 border-b border-rule bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 font-display text-[0.95rem] font-semibold tracking-tight">
      <span
        class="grid size-7 place-items-center rounded-[7px] bg-ink text-[0.7rem] font-bold text-bg"
        aria-hidden="true">SB</span
      >
      <span>SparkyBin Browser</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 sm:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={path === link.href ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-1.5 text-sm transition-colors",
              path === link.href
                ? "text-ink"
                : "text-ink-soft hover:bg-bg-tint hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/download"
      class="ml-auto inline-flex items-center gap-1.5 rounded-lg bg-ink px-3.5 py-1.5 text-sm font-medium text-bg transition-transform hover:-translate-y-px sm:ml-0"
    >
      Download
      <span aria-hidden="true">→</span>
    </a>
  </div>
</header>
