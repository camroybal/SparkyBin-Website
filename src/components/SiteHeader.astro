---
import { PRODUCTS } from "../lib/products";
import mark from "../assets/mark.svg";
import { currentRoute, siteUrl } from "../lib/urls";

const links = [
  { href: "/download", label: "Download" },
  { href: "/source", label: "Source" },
  { href: "/about", label: "About" },
];

/*
 * Download has a button of its own in the bar, so it does not need a link
 * in the list as well. The rest of the pages do.
 */
const navLinks = links.filter((link) => link.href !== "/download");

const path = currentRoute(Astro.url.pathname, import.meta.env.BASE_URL);
---

<header
  class="sticky top-0 z-40 border-b border-rule bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5 sm:px-8">
    <a
      href={siteUrl("/")}
      class="flex items-center gap-2.5 font-display text-[0.95rem] font-semibold tracking-tight"
    >
      <img src={mark.src} alt="" width="28" height="28" class="size-7 rounded-[7px]" />
      <span>SparkyBin</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={siteUrl(link.href)}
            aria-current={path === link.href ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-1.5 text-sm transition-colors",
              path === link.href
                ? "bg-bg-tint text-ink"
                : "text-ink-soft hover:bg-bg-tint hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <details class="group relative" data-menu>
        <summary
          class="flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-1.5 text-sm text-ink-soft transition-colors hover:bg-bg-tint hover:text-ink [&::-webkit-details-marker]:hidden"
        >
          Projects
          <svg
            viewBox="0 0 12 12"
            class="size-3 transition-transform group-open:rotate-180"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M6 8.5 2 4h8L6 8.5Z"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 z-50 mt-1 w-60 overflow-hidden rounded-lg border border-rule bg-surface shadow-lift"
        >
          {
            PRODUCTS.map((product) => (
              <a
                href={siteUrl(product.base)}
                class="block border-b border-rule px-4 py-3 last:border-b-0 transition-colors hover:bg-bg-tint"
              >
                <span class="block font-display text-sm font-semibold">
                  {product.name}
                </span>
                <span class="mt-0.5 block text-xs text-ink-soft">
                  {product.tagline}
                </span>
              </a>
            ))
          }
        </div>
      </details>
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-md border border-rule text-ink-soft transition-colors hover:border-rule-strong hover:bg-bg-tint hover:text-ink"
        aria-label="Colour theme: system"
        title="Colour theme: system"
      >
        <svg
          class="theme-icon theme-icon-system size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"></path>
        </svg>
        <svg
          class="theme-icon theme-icon-light size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg
          class="theme-icon theme-icon-dark size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4 8.4 8.4 0 1 0 20 14.2Z"></path>
        </svg>
      </button>

      <a
        href={siteUrl("/download")}
        aria-current={path === "/download" ? "page" : undefined}
        class="hidden items-center gap-1.5 rounded-lg bg-ink px-3.5 py-1.5 text-sm font-medium text-bg transition-transform hover:-translate-y-px sm:inline-flex"
      >
        Download
        <span aria-hidden="true">→</span>
      </a>

      <details class="group relative md:hidden" data-menu>
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-md border border-rule text-ink-soft transition-colors hover:bg-bg-tint hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg
            class="size-4 group-open:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="hidden size-4 group-open:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>

        <nav
          class="absolute right-0 z-50 mt-1 w-56 overflow-hidden rounded-lg border border-rule bg-surface shadow-lift"
          aria-label="Mobile"
        >
          {
            links.map((link) => (
              <a
                href={siteUrl(link.href)}
                aria-current={path === link.href ? "page" : undefined}
                class:list={[
                  "block border-b border-rule px-4 py-2.5 text-sm transition-colors hover:bg-bg-tint",
                  path === link.href ? "text-ink" : "text-ink-soft",
                ]}
              >
                {link.label}
              </a>
            ))
          }
          {
            PRODUCTS.map((product) => (
              <a
                href={siteUrl(product.base)}
                class="block border-b border-rule px-4 py-2.5 text-sm text-ink-soft transition-colors last:border-b-0 hover:bg-bg-tint"
              >
                {product.name}
                <span class="text-ink-faint"> — {product.tagline}</span>
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  /*
   * The theme button cycles through the system setting, light and dark.
   * The part that matters for the reader is in the document head, which
   * sets the theme before the page is painted; this only handles the
   * button itself and the browser's own colour.
   */
  const STORAGE_KEY = "sparkybin-theme";
  const ORDER = ["system", "light", "dark"] as const;

  type Theme = (typeof ORDER)[number];

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  const read = (): Theme => {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored === "light" || stored === "dark" ? stored : "system";
    } catch {
      return "system";
    }
  };

  const write = (theme: Theme) => {
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      /* A reader with storage turned off still gets the theme for now. */
    }
  };

  const apply = (theme: Theme) => {
    if (theme === "system") {
      delete root.dataset.theme;
    } else {
      root.dataset.theme = theme;
    }

    button?.setAttribute("aria-label", `Colour theme: ${theme}`);
    button?.setAttribute("title", `Colour theme: ${theme}`);

    const dark =
      theme === "dark" ||
      (theme === "system" &&
        window.matchMedia("(prefers-color-scheme: dark)").matches);

    const light = document.querySelector<HTMLMetaElement>('meta[name="theme-color"][data-light]');
    const shade = document.querySelector<HTMLMetaElement>('meta[name="theme-color"][data-dark]');

    light?.setAttribute("media", dark ? "not all" : "all");
    shade?.setAttribute("media", dark ? "all" : "not all");
  };

  button?.addEventListener("click", () => {
    const next = ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length];
    write(next);
    apply(next);
  });

  /* While the reader has not chosen, follow the system as it changes. */
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (read() === "system") apply("system");
    });

  apply(read());
</script>

<script>
  /*
   * The menus are native details elements, so they work without any script
   * at all. This only adds the two things the browser does not do: closing
   * a menu when the reader clicks away from it, and closing it on Escape.
   */
  const menus = document.querySelectorAll<HTMLDetailsElement>("details[data-menu]");

  document.addEventListener("click", (event) => {
    const target = event.target as Node;

    for (const menu of menus) {
      if (menu.open && !menu.contains(target)) {
        menu.removeAttribute("open");
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    for (const menu of menus) {
      if (!menu.open) continue;

      menu.removeAttribute("open");
      menu.querySelector("summary")?.focus();
    }
  });
</script>

