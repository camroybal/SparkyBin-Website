---
import { REPO_URL, ISSUES_URL } from "../lib/releases";
import { PRODUCTS } from "../lib/products";

const links = [
  { href: "/download", label: "Download" },
  { href: "/source", label: "Source" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-40 border-b border-rule bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 font-display text-[0.95rem] font-semibold tracking-tight">
      <span
        class="grid size-7 place-items-center rounded-[7px] bg-ink text-[0.7rem] font-bold text-bg"
        aria-hidden="true">SB</span
      >
      <span>SparkyBin</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 sm:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={path === link.href ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-1.5 text-sm transition-colors",
              path === link.href
                ? "text-ink"
                : "text-ink-soft hover:bg-bg-tint hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <details class="group relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-1.5 text-sm text-ink-soft transition-colors hover:bg-bg-tint hover:text-ink [&::-webkit-details-marker]:hidden"
        >
          Projects
          <svg
            viewBox="0 0 12 12"
            class="size-3 transition-transform group-open:rotate-180"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M6 8.5 2 4h8L6 8.5Z"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 z-50 mt-1 w-60 overflow-hidden rounded-lg border border-rule bg-surface shadow-lift"
        >
          {
            PRODUCTS.map((product) => (
              <a
                href={product.base}
                class="block border-b border-rule px-4 py-3 last:border-b-0 transition-colors hover:bg-bg-tint"
              >
                <span class="block font-display text-sm font-semibold">
                  {product.name}
                </span>
                <span class="mt-0.5 block text-xs text-ink-soft">
                  {product.tagline}
                </span>
              </a>
            ))
          }
        </div>
      </details>
    </nav>

    <a
      href="/download"
      class="ml-auto inline-flex items-center gap-1.5 rounded-lg bg-ink px-3.5 py-1.5 text-sm font-medium text-bg transition-transform hover:-translate-y-px sm:ml-0"
    >
      Download
      <span aria-hidden="true">→</span>
    </a>
  </div>
</header>
